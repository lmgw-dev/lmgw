# NVIDIA's stable toolkit channel for the lmgw server image (headless server design D19): package
# and metadata checks on against NVIDIA's key, which the Containerfile copies in and checks by its
# fingerprint; only the one package the image installs; no experimental channel.
[lmgw-nvidia-container-toolkit]
name=NVIDIA Container Toolkit (lmgw server image)
baseurl=https://nvidia.github.io/libnvidia-container/stable/rpm/$basearch
includepkgs=nvidia-container-toolkit-base
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-lmgw-nvidia-container-toolkit
