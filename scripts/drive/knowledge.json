[
 {
  "js": "'SETUP: EMBED_DIMS=64 scripts/mock-openai.py 9291 &  scripts/dev-instance.sh  then  scripts/knowledge-setup.sh <owner token>  (dev instance on :8899; needs pdftotext for the PDF). Run: scripts/ui-drive.py scripts/drive/knowledge.json --token <token> --base http://127.0.0.1:8899. Deletes every knowledge base of that instance first.'"
 },
 {
  "js": "(async()=>{const j=async(u,b)=>(await fetch(u,{method:b===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:b===undefined?undefined:JSON.stringify(b)})).json();const r=await j('/api/knowledge/bases');for(const k of r.bases)await j('/api/knowledge/bases/'+k.id+'/delete',{});return 'clean'})()"
 },
 {
  "nav": "/knowledge"
 },
 {
  "expect": "document.querySelector('.page-head h1').textContent==='Knowledge'",
  "label": "the Knowledge page opens"
 },
 {
  "expect": "[...document.querySelectorAll('.sidebar a.nav-item, nav a.nav-item')].some(a=>a.getAttribute('href')==='/knowledge')",
  "label": "the sidebar has a Knowledge entry"
 },
 {
  "expect": "document.querySelector('.empty')&&document.querySelector('.empty').textContent.includes('No knowledge bases yet')",
  "label": "an empty list says so"
 },
 {
  "click": ".page-head .actions .btn.primary"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open]')",
