  "timeout": 30
 },
 {
  "expect": "document.querySelector('.sub-nav')&&document.querySelectorAll('.sub-nav .seg-btn').length===3",
  "label": "three tabs"
 },
 {
  "expect": "document.querySelector('.kb-facts').textContent.includes('per-input limit unknown')||document.querySelector('.kb-facts').textContent.includes('tokens per input')",
  "label": "the embedding pin and its input limit are shown"
 },
 {
  "js": "(()=>{const dt=new DataTransfer();dt.items.add(new File(['# Taxes 2025\\n\\nThe tax return was filed in March.\\n\\n## Refund\\n\\nThe refund of 412 EUR arrived in May.\\n\\n## Costs\\n\\n| Item | Amount |\\n| --- | --- |\\n| Accountant | 300 |\\n| Software | 40 |\\n'],'notes.md',{type:'text/markdown'}));const i=document.querySelector('.kb-drop input[type=file]');i.files=dt.files;i.dispatchEvent(new Event('change',{bubbles:true}));return 'picked'})()"
 },
 {
  "js": "(()=>{const b=Uint8Array.from(atob(''),c=>c.charCodeAt(0));const dt=new DataTransfer();dt.items.add(new File([b],'letter.pdf',{type:'application/pdf'}));document.querySelector('.kb-drop').dispatchEvent(new DragEvent('drop',{dataTransfer:dt,bubbles:true,cancelable:true}));return 'dropped'})()"
 },
 {
  "until": "document.querySelectorAll('.kb-files tbody tr').length===2",
  "label": "both files are listed",
  "timeout": 30
 },
 {
  "until": "[...document.querySelectorAll('.kb-files tbody .chip')].length===2&&[...document.querySelectorAll('.kb-files tbody .chip')].every(c=>c.textContent.trim()==='ready')",
  "label": "both files reach ready",
  "timeout": 60
 },
 {
  "expect": "document.querySelector('.kb-results')&&document.querySelector('.kb-results').textContent.includes('added')",
