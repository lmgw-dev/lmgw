  "label": "one waiting card, open, with its bar"
 },
 {
  "expect": "document.querySelector('.tool-card.await pre').textContent.includes('\"id\": \"7\"')",
  "label": "the arguments are shown"
 },
 {
  "shot": "02-waiting-one"
 },
