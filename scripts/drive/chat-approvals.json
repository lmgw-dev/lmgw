[
 {
  "js": "'Run: scripts/chat-approvals-drive.sh (dev instance on :8917, the model scripted by mock-openai TOOL_SCRIPT, scripts/mock-mcp.py as the `notes` server)'"
 },
 {
  "nav": "/chat"
 },
 {
  "script": "scripts/drive/chat-approvals.js"
 },
 {
  "js": "(async()=>{const id=await __ap.mk();location.href='/chat?t='+id;return id})()"
 },
 {
  "until": "!!document.querySelector('.dock-rail,.chat-settings')",
  "timeout": 20
 },
 {
  "script": "scripts/drive/chat-approvals.js"
 },
 {
  "js": "(() => { const r = document.querySelector('.dock-rail'); if (r) r.click(); return r ? 'opened' : 'already open'; })()"
 },
 {
  "until": "!![...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes'))",
  "timeout": 20
 },
 {
  "js": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelector(':scope > label input').click(); 'attached'"
 },
 {
  "until": "!![...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelector('.mcp-approval')",
  "timeout": 20
 },
 {
  "expect": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelectorAll('.ask-tick').length === 0",
  "label": "no ask ticks until the per-tool mode is picked"
 },
 {
  "js": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelector('[data-approval-mode] .seg-btn:nth-child(3)').click(); 'per tool'"
 },
 {
  "until": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelectorAll('.ask-tick').length === 3",
  "timeout": 20
 },
 {
  "js": "[...[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelectorAll('.tool-pick')].find(t => t.textContent.includes('delete_note')).querySelector('.ask-tick input').click(); 'ask on delete_note'"
 },
 {
  "expect": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).querySelector('[data-approval-mode] .seg-btn.on').textContent === 'per tool'",
  "label": "per-tool mode is shown as picked"
 },
 {
  "js": "[...document.querySelectorAll('.mcp-pick')].find(p => p.textContent.startsWith('notes')).scrollIntoView({block:'center'}); 'scrolled'"
 },
 {
  "wait": 0.4
 },
 {
  "shot": "01-editor-per-tool"
 },
 {
  "click": ".chat-settings-save .btn.primary"
 },
 {
  "wait": 1
 },
 {
  "expect": "(async()=>{const t=(await __ap.thread()).thread;const r=t.mcp_tools[0].require_approval;return JSON.stringify(r.always.tool_names).includes('delete_note') && !r.never})()",
  "label": "saved as the OpenAI object shape, only the ticked tool"
