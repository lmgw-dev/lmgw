[
 {
  "js": "'SETUP: ECHO=1 STREAM_DELAY=0.02 scripts/mock-openai.py 9291 &  scripts/dev-instance.sh  then  scripts/chat-actions-setup.sh <owner token>, plus two more aliases on the same upstream: fake-novision and fake-vision, model_set with capabilities_override {capabilities:{task:chat,vision:false|true,input_modalities:[text] | [text,image]}} (vision is its own key, not derived from the modalities), and settings_set chat_pdf_mode=ask. Run: scripts/ui-drive.py scripts/drive/chat-attachments.json --token <token> --base http://127.0.0.1:8899. Needs pdftotext (poppler-utils). Wipes every chat thread of that instance first.'"
 },
 {
  "js": "(async()=>{const j=async(u,b)=>(await fetch(u,{method:b===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:b===undefined?undefined:JSON.stringify(b)})).json();await j('/api/op/settings_set',{chat_pdf_mode:'ask'});const t=await j('/chat/api/threads?archived=all');for(const x of t.threads)await j('/chat/api/threads/'+x.id+'/delete',{});return 'wiped '+t.threads.length})()"
 },
 {
  "js": "(async()=>{const j=async(u,b)=>(await fetch(u,{method:b===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:b===undefined?undefined:JSON.stringify(b)})).json();const r=await j('/chat/api/threads',{model_alias:'fake-echo',kind:'chat'});setTimeout(()=>location.assign('/chat?t='+r.id),50);return r.id})()"
 },
 {
