[
 {
  "js": "'Knowledge as a list beside the selected base: SETUP as scripts/drive/knowledge.json (mock-openai with EMBED_DIMS=64, a dev instance, scripts/knowledge-setup.sh for fake-embed); this drive deletes every knowledge base of that instance first and makes three. It drives the status page, a click selecting (its path), ↑ ↓ Home End, the search (/ focuses it, Esc clears it, a second Esc goes back to the list), a deep link to a tab, an edit on Settings (the accent dot, the save toast, the guard asking when another row is picked, Stay, Ctrl+S saving, the value read back after a reload, then put back), and the narrow window (one pane, the back button). It SAVES: a dev instance only. Run: scripts/ui-drive.py scripts/drive/knowledge-split.json --dsf 1.25 --token-file <dir>.token --base http://<addr> --podman-guard <prefix>'"
 },
 {
  "js": "(async()=>{const j=async(u,b)=>(await fetch(u,{method:b===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:b===undefined?undefined:JSON.stringify(b)})).json();const r=await j('/api/knowledge/bases');for(const k of r.bases)await j('/api/knowledge/bases/'+k.id+'/delete',{});for(const n of ['demo-alpha','demo-beta','demo-gamma'])await j('/api/knowledge/bases',{name:n,description:'drive base '+n,embed_alias:'fake-embed',rerank_alias:'',vision_alias:'',chunk_tokens:256,chunk_overlap:32,mcp_visible:true});const b=await j('/api/knowledge/bases');window.__ids=b.bases.map(k=>k.id);return JSON.stringify(b.bases.map(k=>k.name))})()"
 },
