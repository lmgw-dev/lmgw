 },
 {
  "wait": 2
 },
 {
  "expect": "!document.querySelector('dialog[open]')&&(document.querySelector('.toast-host')||{textContent:''}).textContent.includes('folder 999999')",
  "label": "a folder not in the list: no form, a toast says so"
 }
