[
 {
  "nav": "/usage/keys"
 },
 {
  "until": "document.querySelector('.kstatus')",
  "timeout": 10,
  "label": "the status page is up"
 },
 {
  "expect": "[...document.querySelectorAll('.kstatus .pref-head h2')].some(h => h.textContent === 'Devices') && !!document.querySelector('.kstatus .dev-strip-row')",
  "label": "pairing and the link strip are on the status page's Devices group"
 },
 {
  "shot": "keys"
 },
 {
  "js": "[...document.querySelectorAll('.kstatus .prow.action')].find(r => r.textContent.startsWith('Pair a device')).click(); 'pair'"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open] .pair-form') !== null",
  "label": "Pair a device opens the form"
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] .pair-form .prow-title')].some(l => l.textContent === 'Budget')",
  "label": "the budget is on the form"
 },
 {
  "shot": "pair-form"
 },
 {
  "click": "dialog[open] input[aria-label='Device name']"
 },
 {
  "js": "(() => { const i = document.querySelector(\"dialog[open] input[aria-label='Device name']\"); i.value = 'drive-' + Date.now().toString(36); i.dispatchEvent(new Event('input', {bubbles: true})); window.__driveName = i.value; return i.value; })()"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "wait": 0.3
 },
 {
  "expect": "document.querySelector('dialog[open] .pair-review') !== null",
  "label": "Review restates the reach before anything is minted"
 },
 {
  "expect": "document.querySelector('dialog[open] .notice.warn') !== null",
  "label": "every alias and no budget is flagged on the review"
 },
 {
  "shot": "pair-review"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "until": "document.querySelector('dialog[open] .pair-link')?.textContent.startsWith('lmgw-pair:?v=2&name=')",
  "timeout": 10,
  "label": "the link is shown once"
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] button')].some(b => b.textContent === 'Copy link')",
  "label": "the link has a Copy button"
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] a.btn')].some(a => a.textContent.startsWith('Open') && a.getAttribute('href')?.startsWith('lmgw-pair:'))",
  "label": "Open is a plain lmgw-pair: link"
 },
 {
  "js": "(() => { const l = document.querySelector('dialog[open] .pair-link'); l.textContent = 'lmgw-pair:?v=2&name=\u2026&url=\u2026&fp=\u2026&token=(masked for the shot)'; return 'masked'; })()"
 },
 {
  "expect": "!document.querySelector('dialog[open]').textContent.includes('lmgw-device-')",
  "label": "no key is on screen when the link is shot (it is masked)"
 },
 {
  "shot": "pair-link"
 },
 {
  "key": "Escape"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] h2, dialog[open] .modal-title')].some(h => h.textContent.includes('End the pairing code?'))",
  "label": "closing the card asks about the pairing code"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "wait": 0.4
 },
 {
  "until": "!!([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName))",
  "timeout": 10,
  "label": "the new device is listed under Devices"
 },
 {
  "js": "([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName)).click(); 'open'"
 },
 {
  "until": "document.querySelector('.kdetail .detail-hero h1')?.textContent === window.__driveName",
  "timeout": 10,
  "label": "its detail opens"
 },
 {
  "expect": "[...document.querySelectorAll('.kdetail .detail-hero .chip.warn')].some(c => c.textContent === 'every alias \u00b7 no budget')",
  "label": "an unscoped, unbudgeted device is flagged amber"
 },
 {
  "expect": "[...document.querySelectorAll('.kdetail .prow-title')].some(t => t.textContent.startsWith('Hosts tools as')) && ![...document.querySelectorAll('.kdetail .prow-title')].some(t => t.textContent === 'Enabled')",
  "label": "a device's policy edits its hosting label; Enabled is not a row (Disable asks first)"
 },
 {
  "shot": "device-detail"
 },
 {
  "js": "[...document.querySelectorAll('.kdetail .prow.action')].find(r => r.textContent.startsWith('Disable the device')).click(); 'disable'"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open] .notice.warn')?.textContent.includes('close now')",
  "label": "Disable says what it ends before it does it"
 },
 {
  "shot": "disable-confirm"
 },
 {
  "key": "Escape"
 },
 {
  "wait": 0.3
 },
 {
  "expect": "!document.querySelector('dialog[open]')",
  "label": "Cancel ends nothing"
 },
 {
  "js": "[...document.querySelectorAll('.kdetail .prow.action')].find(r => r.textContent.startsWith('Delete the device')).click(); 'delete'"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open] .notice.warn')?.textContent.includes('close now')",
  "label": "Delete says what it ends before it does it"
 },
 {
  "click": "dialog[open] .modal-foot button.danger"
 },
 {
  "until": "location.pathname === '/usage/keys' && !([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName))",
  "timeout": 10,
  "label": "the drive's device is deleted, its page closed: no live credential is left behind"
 }
]
