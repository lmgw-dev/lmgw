[
 {
  "js": "'SETUP: ECHO=1 STREAM_DELAY=0.02 scripts/mock-openai.py 9291 &  then  scripts/chat-actions-setup.sh <owner token>  (dev instance on :8899). Run: scripts/ui-drive.py scripts/drive/chat-actions.json --token <token>'"
 },
 {
  "nav": "/chat"
 },
 {
  "wait": 1
 },
 {
  "js": "(async()=>{const r=await fetch('/chat/api/threads',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({model_alias:'fake-echo',kind:'chat'})});const t=await r.json();return t.id})()"
 },
 {
  "nav": "/chat"
 },
 {
  "wait": 1.5
 },
 {
  "js": "Object.defineProperty(navigator,'clipboard',{configurable:true,value:{writeText:async t=>{window.__clip=t}}}); 'clipboard stubbed'"
 },
 {
  "click": ".composer-input"
 },
 {
  "type": "hello one"
 },
 {
  "key": "Enter"
 },
 {
  "wait": 1.2
 },
 {
  "click": ".composer-input"
 },
 {
  "type": "hello two"
 },
 {
  "key": "Enter"
 },
 {
  "wait": 1.2
 },
 {
  "expect": "[...document.querySelectorAll('.msg-user-text')].map(e=>e.textContent).join('|')==='hello one|hello two'",
  "label": "two user bubbles"
 },
 {
  "expect": "[...document.querySelectorAll('.chat-col .msg-assistant .md')].map(e=>e.textContent.trim()).join('|')==='Echo: hello one|Echo: hello two'",
  "label": "the echo upstream answered both"
 },
 {
  "expect": "document.querySelectorAll('.chat-col .msg-actions').length===4",
  "label": "an action row under every settled message"
 },
 {
  "expect": "[...document.querySelectorAll('.chat-col .msg-assistant .msg-answered-by')].map(e=>e.textContent.trim()).join('|')==='fake-echo|fake-echo'",
  "label": "each reply names the model that answered"
 },
 {
  "expect": "!document.querySelector('.msg-unsaved')",
  "label": "no reply of a normal turn is marked unsaved"
 },
 {
  "expect": "!document.querySelector('.chat-col .msg-actions button[aria-label=\"Continue\"]') === false",
  "label": "Continue is offered (llama-server route) on the last reply only"
 },
 {
  "expect": "document.querySelectorAll('.chat-col .msg-actions button[aria-label=\"Continue\"]').length===1",
  "label": "exactly one Continue"
 },
 {
  "shot": "chat-actions-rows"
 },
 {
  "click": ".chat-col .msg-actions button[aria-label=\"Copy\"]",
  "nth": 3
 },
 {
  "wait": 0.3
 },
 {
  "expect": "window.__clip==='Echo: hello two'",
  "label": "Copy puts the markdown source on the clipboard"
 },
 {
  "click": ".chat-col .msg-actions button[aria-label=\"Edit\"]",
  "nth": 3
 },
 {
  "wait": 0.3
 },
 {
  "expect": "!!document.querySelector('.msg-edit-ta')",
  "label": "the reply opens in an editor"
 },
 {
  "js": "(()=>{const t=document.querySelector('.msg-edit-ta');t.value='EDITED reply';t.dispatchEvent(new Event('input',{bubbles:true}))})()"
 },
 {
  "shot": "chat-actions-edit"
 },
 {
  "click": ".msg-edit-btns .btn.primary"
 },
 {
  "wait": 0.8
 },
 {
  "expect": "[...document.querySelectorAll('.chat-col .msg-assistant .md')].map(e=>e.textContent.trim())[1]==='EDITED reply'",
  "label": "an assistant edit is in place, no resend"
 },
 {
  "expect": "!document.querySelector('.msg-edit-ta')",
  "label": "the editor closed"
 },
 {
  "expect": "[...document.querySelectorAll('.msg-user-text')].map(e=>e.textContent).length===2",
  "label": "still two user messages"
 },
 {
  "js": "(async()=>{window.__v=false;try{window.__v=await ((async()=>{const id=new URLSearchParams(location.search).get('t');const d=await (await fetch('/chat/api/threads/'+id)).json();const m=d.messages;return m[3].content==='EDITED reply'})())}catch(e){window.__v=String(e)===''}})()"
 },
 {
  "expect": "window.__v",
  "label": "and it is stored"
 },
 {
  "click": ".chat-col .msg-actions button[aria-label=\"Edit\"]",
  "nth": 0
 },
 {
  "wait": 0.3
 },
 {
  "expect": "document.querySelector('.msg-edit-note').textContent.includes('discards 3 later messages')",
  "label": "the editor says how many messages go"
 },
 {
  "expect": "document.querySelector('.msg-edit-btns .btn.primary').textContent==='Save & send'",
  "label": "a user edit is Save & send"
 },
 {
