[
 {
  "nav": "/usage/keys"
 },
 {
  "until": "document.querySelector('.kstatus')",
  "timeout": 10,
  "label": "the status page is up"
 },
 {
  "js": "[...document.querySelectorAll('.kstatus .prow.action')].find(r => r.textContent.startsWith('Pair a device')).click(); 'pair'"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open] .pair-form') !== null",
  "label": "Pair a device opens the form"
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] .pair-form .prow-title')].some(l => l.textContent === 'Admin tools')",
  "label": "the pairing form has the admin-tools level"
 },
 {
  "click": "dialog[open] input[aria-label='Device name']"
 },
 {
  "js": "(() => { const i = document.querySelector(\"dialog[open] input[aria-label='Device name']\"); i.value = 'drive-admin-' + Date.now().toString(36); i.dispatchEvent(new Event('input', {bubbles: true})); window.__driveName = i.value; return i.value; })()"
 },
 {
  "js": "[...document.querySelectorAll('dialog[open] .pair-form .prow')].find(r => r.querySelector('.prow-title')?.textContent === 'Admin tools').querySelector('.select > button').click(); 'open level'"
 },
 {
  "wait": 0.2
 },
 {
  "click": ".select-opt",
  "nth": 1
 },
 {
  "wait": 0.2
 },
 {
  "shot": "pair-form-admin-tools"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "wait": 0.3
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] .pair-review tr')].some(r => r.querySelector('th')?.textContent === 'Admin tools' && r.querySelector('td')?.textContent.includes('read only'))",
  "label": "the review restates the level"
 },
 {
  "shot": "pair-review-admin-tools"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "until": "document.querySelector('dialog[open] .pair-link')?.textContent.startsWith('lmgw-pair:?v=2&name=')",
  "timeout": 10,
  "label": "paired: the link is shown once"
 },
 {
  "key": "Escape"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "[...document.querySelectorAll('dialog[open] h2, dialog[open] .modal-title')].some(h => h.textContent.includes('End the pairing code?'))",
  "label": "closing the card asks about the pairing code"
 },
 {
  "click": "dialog[open] .modal-foot button.primary"
 },
 {
  "wait": 0.4
 },
 {
  "until": "!!([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName))",
  "timeout": 10,
  "label": "the new device is listed"
 },
 {
  "js": "([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName)).click(); 'open'"
 },
 {
  "until": "[...document.querySelectorAll('.kdetail .detail-hero .chip')].some(c => c.textContent === 'admin tools: read only')",
  "timeout": 10,
  "label": "its hero carries the admin tools: read only chip"
 },
 {
  "expect": "document.querySelector('.kdetail .dev-admin .select-btn').textContent.includes('Read only')",
  "label": "its level reads Read only"
 },
 {
  "shot": "device-admin-tools"
 },
 {
  "click": ".kdetail .dev-admin .select > button"
 },
 {
  "wait": 0.2
 },
 {
  "click": ".select-opt",
  "nth": 0
 },
 {
  "wait": 0.4
 },
 {
  "until": "![...document.querySelectorAll('.kdetail .detail-hero .chip')].some(c => c.textContent.startsWith('admin tools')) && !document.querySelector('dialog[open]')",
  "timeout": 10,
  "label": "Off applies at once, no question: the chip goes"
 },
 {
  "click": ".kdetail .dev-admin .select > button"
 },
 {
  "wait": 0.2
 },
 {
  "click": ".select-opt",
  "nth": 2
 },
 {
  "wait": 0.4
 },
 {
  "expect": "document.querySelector('dialog[open] .notice.warn')?.textContent.includes('change lmgw')",
  "label": "Full asks first, saying what it lets the device do"
 },
 {
  "shot": "allow-admin-tools-confirm"
 },
 {
  "key": "Escape"
 },
 {
  "wait": 0.4
 },
 {
  "expect": "!document.querySelector('dialog[open]') && ![...document.querySelectorAll('.kdetail .detail-hero .chip')].some(c => c.textContent.startsWith('admin tools')) && document.querySelector('.kdetail .dev-admin .select-btn').textContent.includes('Off')",
  "label": "Cancel allows nothing, and the dropdown goes back to Off"
 },
 {
  "click": ".kdetail .dev-admin .select > button"
 },
 {
  "wait": 0.2
 },
 {
  "click": ".select-opt",
  "nth": 2
 },
 {
  "wait": 0.4
 },
 {
  "click": "dialog[open] .modal-foot button.danger"
 },
 {
  "until": "[...document.querySelectorAll('.kdetail .detail-hero .chip')].some(c => c.textContent === 'admin tools: full')",
  "timeout": 10,
  "label": "confirmed: full"
 },
 {
  "js": "[...document.querySelectorAll('.kdetail .prow.action')].find(r => r.textContent.startsWith('Delete the device')).click(); 'delete'"
 },
 {
  "wait": 0.4
 },
 {
  "click": "dialog[open] .modal-foot button.danger"
 },
 {
  "until": "location.pathname === '/usage/keys' && !([...document.querySelectorAll('.mlist .lrow')].find(r => r.querySelector('.lrow-name')?.textContent === window.__driveName))",
  "timeout": 10,
  "label": "the drive's device is deleted: no live credential is left behind"
 }
]
