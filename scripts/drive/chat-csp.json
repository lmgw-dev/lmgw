[
 {"js": "'SETUP and RUN: scripts/csp-check.sh (a dev instance behind scripts/csp-check/proxy.py, which adds an extension page\\'s script-src \\'self\\' \\'wasm-unsafe-eval\\' to every answer and records violations). The dashboard host: fetch transport, the shell\\'s stream, a srcdoc preview. Its links stay the routes themselves.'"},
 {"nav": "/__csp-check/canary.html"},
 {"wait": 1},
 {"expect": "document.body.dataset.ran === undefined", "label": "canary: an inline script is refused under the policy"},
 {"js": "localStorage.removeItem('lmgw-test-host'); 'dashboard host'"},
 {"nav": "/chat"},
 {"script": "scripts/csp-check/drive-helpers.js"},
 {"js": "__csp.open('fake-vision')"},
 {"wait": 2.5},
 {"script": "scripts/csp-check/drive-helpers.js"},
 {"until": "!!document.querySelector('.composer-input') && !!document.querySelector('.composer input[type=file]')", "label": "the Chat mounted under the policy (start.js loaded the app)", "timeout": 30},
 {"expect": "!!document.querySelector('meta[name=lmgw-wasm]') && ![...document.scripts].some(s => !s.src)", "label": "the page holds no inline script"},
 {"js": "__csp.compose(__csp.PROBE)"},
 {"js": "__csp.send()"},
 {"until": "(__csp.reply()?.textContent || '').includes('preview body')", "label": "the reply streamed in", "timeout": 30},
 {"until": "!!__csp.reply().querySelector('pre code.hljs .hljs-keyword')", "label": "highlight.js highlighted the Python block", "timeout": 15},
 {"until": "!!__csp.reply().querySelector('.math-inline .katex')", "label": "KaTeX rendered the math", "timeout": 15},
 {"until": "!!__csp.reply().querySelector('.mermaid-wrap .mermaid-view svg')", "label": "Mermaid drew the diagram", "timeout": 20},
 {"expect": "!__csp.reply().querySelector('.mermaid-error')", "label": "no diagram error"},
 {"shot": "csp-dashboard-render"},
 {"js": "[...__csp.reply().querySelectorAll('.code-tools button')].find(b => b.textContent.includes('Preview')).click(); 'preview'"},
 {"until": "!!document.querySelector('dialog[open] iframe.preview-frame')", "label": "the preview opens", "timeout": 10},
 {"expect": "(() => { const f = document.querySelector('dialog[open] iframe.preview-frame'); return f.getAttribute('sandbox').includes('allow-scripts') && f.getAttribute('srcdoc').includes('preview body') && !f.getAttribute('src'); })()", "label": "the dashboard keeps its sandboxed srcdoc frame"},
 {"key": "Escape"},
 {"wait": 0.4},
 {"js": "__csp.up('dot.png', __csp.PNG, 'image/png')"},
 {"until": "!!document.querySelector('.draft-chips img.chip-thumb')?.getAttribute('src')", "label": "the picture's chip shows", "timeout": 15},
 {"expect": "/^\\/chat\\/api\\/attachments\\/\\d+$/.test(document.querySelector('.draft-chips img.chip-thumb').getAttribute('src'))", "label": "on the dashboard a thumbnail loads its route itself, as before"},
 {"until": "document.querySelector('.draft-chips img.chip-thumb').naturalWidth === 1", "label": "the thumbnail loaded", "timeout": 10},
 {"js": "__csp.hookDownloads()"},
 {"click": ".chat-head .export-menu button"},
 {"wait": 0.3},
 {"js": "__csp.menuItem('Export as Markdown')"},
 {"wait": 0.5},
 {"expect": "(() => { const d = window.__downloads[0]; return !!d && /^\\/chat\\/api\\/threads\\/\\d+\\/export\\?format=md$/.test(d.href) && /^lmgw-chat-\\d+\\.md$/.test(d.name); })()", "label": "on the dashboard an export is the route's own download link, as before"},
 {"js": "JSON.stringify(window.__downloads)"}
]
