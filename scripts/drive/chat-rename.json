[
 {"js": "'SETUP: a dev instance (scripts/dev-instance.sh) with the alias fake-echo (scripts/chat-actions-setup.sh <owner token>), and at least two chat threads. Run: scripts/ui-drive.py scripts/drive/chat-rename.json --token <token> --base http://127.0.0.1:8899 --dsf 1.25. Renames thread rows; leaves the first one named Holiday at the lake.'"},
 {"nav": "/chat"},
 {"wait": 1.5},
 {"click": ".thread-row .row-menu-btn", "nth": 1},
 {"wait": 0.5},
 {"shot": "rename-menu"},
 {"expect": "[...document.querySelectorAll('[role=menuitem]')].some(e=>e.textContent.trim()==='Rename')", "label": "the row menu offers Rename"},
 {"js": "[...document.querySelectorAll('[role=menuitem]')].find(e=>e.textContent.trim()==='Rename').click()"},
 {"wait": 0.5},
 {"expect": "document.activeElement&&document.activeElement.classList.contains('thread-rename')", "label": "the rename box has focus"},
 {"shot": "rename-edit"},
 {"type": "Holiday at the lake"},
 {"key": "Enter"},
 {"wait": 1},
 {"expect": "[...document.querySelectorAll('.thread-title')].some(e=>e.textContent.includes('Holiday at the lake'))", "label": "the list shows the new title"},
 {"js": "document.querySelectorAll('.thread-row')[0].focus()"},
 {"key": "F2"},
 {"wait": 0.4},
 {"expect": "document.activeElement.classList.contains('thread-rename')", "label": "F2 on a focused row opens rename"},
 {"key": "Escape"},
 {"wait": 0.3},
 {"expect": "!document.querySelector('.thread-rename')", "label": "Esc cancels"},
 {"js": "document.querySelectorAll('.thread-row')[0].focus()"},
 {"key": "F2"},
 {"wait": 0.3},
 {"js": "document.activeElement.value=''"},
 {"key": "Enter"},
 {"wait": 1},
 {"shot": "rename-empty"},
 {"expect": "document.body.innerText.toLowerCase().includes('rename failed')", "label": "an empty title shows the server's refusal"}
]
