[
 {
  "nav": "/chat"
 },
 {
  "wait": 1
 },
 {
  "js": "'needs the mock at STREAM_DELAY=4 (ECHO=1 STREAM_DELAY=4 scripts/mock-openai.py PORT) and the fake-echo alias; each case leaves Chat mid-stream, waits for the server to finish, and checks the STORED reply is complete'"
 },
 {
  "js": "(async()=>{const j=(u,b)=>fetch(u,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(b)});const t=await (await j('/chat/api/threads',{model_alias:'fake-echo',kind:'chat'})).json();await (await j(`/chat/api/threads/${t.id}/send`,{content:\"one two three\"})).text();const d=await (await fetch(`/chat/api/threads/${t.id}`)).json();const a=d.messages.find(m=>m.role==='assistant');await j(`/chat/api/threads/${t.id}/messages/${a.id}/edit`,{content:\"OLD\"});localStorage.setItem('lvR',t.id);return t.id})()"
 },
 {
  "nav": "/chat"
 },
 {
  "wait": 2
 },
 {
  "wait": 0.5
 },
 {
  "click": ".chat-col .msg-assistant .msg-actions button[aria-label=\"Regenerate\"]"
 },
 {
  "wait": 0.4
 },
 {
  "go": "/settings"
 },
 {
  "until": "(async()=>{const id=localStorage.getItem('lvR');const d=await (await fetch('/chat/api/threads/'+id)).json();return d.messages.filter(m=>m.role==='assistant').map(m=>m.content).join('|')})().then(s=>s===\"Echo: one two three\")",
  "timeout": 45,
  "label": "regenerate: leaving Chat mid-stream, the stored reply ends up complete"
 },
 {
