[
 {
  "js": "(async()=>{const j=async(u,b)=>(await fetch(u,{method:b===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:b===undefined?undefined:JSON.stringify(b)})).json();const r=await j('/api/usage/keys');let n=0;for(const k of (r.keys||[]))if(k.name==='drive-key'){await j('/api/op/key_delete',{id:k.id});n++}return 'removed '+n+' earlier drive-key'})()"
 },
 {
  "nav": "/usage/keys"
 },
 {
  "wait": 0.6
 },
 {
