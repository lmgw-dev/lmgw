{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lmgw",
  "version": "0.6.0",
  "identifier": "io.github.lmgw-dev.lmgw",
  "build": {},
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "compression": { "type": "zstd", "level": 6 },
        "depends": ["git", "podman", "poppler-utils", "opus", "polkit"],
        "files": {
          "/usr/libexec/lmgw/lmgw-machine-helper": "../target/release/lmgw-machine-helper",
          "/usr/share/polkit-1/actions/io.github.lmgw-dev.lmgw.machine-setup.policy": "../crates/lmgw-machine-helper/polkit/io.github.lmgw-dev.lmgw.machine-setup.policy",
          "/usr/share/licenses/lmgw/onnxruntime/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-onnxruntime",
          "/usr/share/licenses/lmgw/onnxruntime/ThirdPartyNotices.txt": "../crates/lmgw-core/assets/realtime/ThirdPartyNotices-onnxruntime.txt",
          "/usr/share/licenses/lmgw/silero-vad/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-silero",
          "/usr/share/licenses/lmgw/smart-turn/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-smart-turn",
          "/usr/share/licenses/lmgw/smart-turn/LICENSE-whisper": "../crates/lmgw-core/assets/realtime/LICENSE-whisper"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/licenses/lmgw/onnxruntime/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-onnxruntime",
          "/usr/share/licenses/lmgw/onnxruntime/ThirdPartyNotices.txt": "../crates/lmgw-core/assets/realtime/ThirdPartyNotices-onnxruntime.txt",
          "/usr/share/licenses/lmgw/silero-vad/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-silero",
          "/usr/share/licenses/lmgw/smart-turn/LICENSE": "../crates/lmgw-core/assets/realtime/LICENSE-smart-turn",
          "/usr/share/licenses/lmgw/smart-turn/LICENSE-whisper": "../crates/lmgw-core/assets/realtime/LICENSE-whisper"
        }
      }
    }
  }
}
